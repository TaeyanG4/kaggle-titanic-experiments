digraph workflow {
  graph [rankdir=TB, bgcolor="white", pad="0.32", nodesep="0.36", ranksep="0.38", fontname="Arial", label="How the experiment was run", labelloc="t", labeljust="l", fontsize=24, fontcolor="#16324a", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#f3f7fa", color="#bdcbd5", fontname="Arial", fontsize=16, fontcolor="#16324a", margin="0.26,0.16", penwidth=1.2];
  edge [color="#687c89", arrowsize=0.8, penwidth=1.3, fontname="Arial", fontsize=12, fontcolor="#465c6b"];
  setup [label="Antigravity\nInitial environment setup"];
  direction [label="Human direction\nSkills, prompts and constraints"];
  session [label="GPT web session\nRead plan, propose a change", fillcolor="#e4f3ef", color="#82b5a7"];
  run [label="Local execution tools\nWrite code and run Python"];
  evidence [label="Evaluate the candidate\nOOF, split results and errors"];
  approval [shape=diamond, label="Submit this\ncandidate?", fillcolor="#fff5e7", color="#d2b587", margin="0.13,0.08"];
  kaggle [label="Kaggle submission\nAfter human approval", fillcolor="#e4f3ef", color="#82b5a7"];
  record [label="Keep the experiment record\nScores, failures, files and hashes"];
  {rank=same; setup; direction;}
  setup -> session;
  direction -> session;
  session -> run -> evidence -> approval;
  approval -> kaggle [label="approved"];
  approval -> record [label="hold / reject"];
  kaggle -> record;
  record -> session [label="next question", style=dashed, constraint=false];
}
